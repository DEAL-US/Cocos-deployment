# Settings of the bio service. Copy this file to .env, next to docker-compose.yml, to change them;
# without a .env, the service uses the values below.

# Bakta database used for annotation: light or full (see "Bakta database" in the README).
# It is read from data/db-light or data/db-full; `python deploy.py --download-bakta-db light|full` downloads it.
BAKTA_DB_TYPE=light

# Assembler of ONT reads when a job does not ask for one: raven or flye.
DEFAULT_ONT_ASSEMBLER=raven
